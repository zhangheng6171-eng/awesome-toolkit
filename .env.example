# Awesome Toolkit — 环境变量
# 复制此文件为 .env.local，填入实际值

# 站点基础 URL（用于构造 Docker Compose 文件下载链接等）
NEXT_PUBLIC_BASE_URL=https://awesome-toolkit.pages.dev

# Cloudflare 相关
# KV Namespace IDs — 用 wrangler kv:namespace create 命令获取
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# 如果需要 AI 描述生成
# ANTHROPIC_API_KEY=sk-ant-xxx

# GitHub（用于 Issues 提交）
# GITHUB_TOKEN=ghp_xxx
